# syntax=docker/dockerfile:1
# Multi-arch: build stage runs on $BUILDPLATFORM and cross-compiles for $TARGETARCH (see
# Dockerfile.api for the rationale; dotnet uses RID arch "x64" where Docker says "amd64").
FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG TARGETARCH
WORKDIR /app
COPY src/Directory.Build.props src/Directory.Packages.props src/EMaigrator.sln ./src/
COPY src/ ./src/
RUN arch=$(case "$TARGETARCH" in amd64) echo x64;; *) echo "$TARGETARCH";; esac) \
    && dotnet restore src/EMaigrator.Workers/EMaigrator.Workers.csproj -a "$arch" \
    && dotnet publish src/EMaigrator.Workers/EMaigrator.Workers.csproj -c Release -a "$arch" -o /out --no-restore

# aspnet (not plain runtime): the Workers publish output requires the Microsoft.AspNetCore.App
# shared framework (pulled in transitively via EMaigrator.Infrastructure — SignalR/hosting/health).
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /out ./
ENTRYPOINT ["dotnet", "EMaigrator.Workers.dll"]
