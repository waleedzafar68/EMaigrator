# syntax=docker/dockerfile:1

# ── Build the SPA (production: mocks are tree-shaken out — VITE_USE_MOCKS is never set) ──
FROM node:22-alpine AS build
WORKDIR /app
COPY web/ ./
# npm ci wipes and reinstalls node_modules for linux even if the host's were copied in, so the build
# is correct regardless of the .dockerignore.
RUN npm ci && npm run build

# ── Serve the static bundle + reverse-proxy /api and /hubs to the api service ──
FROM nginx:alpine AS runtime
COPY deploy/web-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
