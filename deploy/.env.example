# Copy to deploy/.env and set values for your environment. deploy/.env is git-ignored.
# Every var here has a safe default in docker-compose.yml, so this whole file is optional for a throwaway
# local run — but you SHOULD set real secrets for anything beyond that. Use with:
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d
# Open the app at http://localhost:${WEB_PORT}  (default http://localhost:3000)

# ---- Credentials (override for any non-throwaway deployment) ----
POSTGRES_USER=emaigrator
POSTGRES_PASSWORD=change-me
POSTGRES_DB=emaigrator
RABBITMQ_USER=emaigrator
RABBITMQ_PASSWORD=change-me

# ---- Security keys (REQUIRED for any non-throwaway deployment) ----
# SECRET_MASTER_KEY wraps provider credentials at rest; it MUST be identical on api + workers.
#   Generate a base64-encoded 32-byte key, e.g.:  openssl rand -base64 32
SECRET_MASTER_KEY=change-me-base64-encoded-32-byte-key
# JWT_SIGNING_KEY signs API auth tokens; use a long (>= 32 char) random string.
JWT_SIGNING_KEY=change-me-long-random-secret
# SECRET_STORE_MODE: LocalKey (default) keeps the master key local; other modes are for hosted deployments.
SECRET_STORE_MODE=LocalKey

# ---- Published host ports (remap these to avoid clashes with other local stacks) ----
# Internal service-to-service traffic is unaffected — containers use service DNS on fixed container ports.
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
REDIS_PORT=6379
API_PORT=8080
WEB_PORT=3000

# ---- App / runtime ----
ASPNETCORE_ENVIRONMENT=Production
DOTNET_ENVIRONMENT=Production
# Browser origin the API's CORS policy allows. Defaults to http://localhost:${WEB_PORT}. Set this if the
# SPA is served from a different origin (e.g. a Vite dev server on :5173 negotiating the SignalR hub).
# WEB_ORIGIN=http://localhost:3000
# Restart policy for every service (no | on-failure | always | unless-stopped).
RESTART_POLICY=unless-stopped
# Compose project name (containers/volumes are namespaced under it).
# COMPOSE_PROJECT_NAME=emaigrator

# ---- Image tags (pin/upgrade the backing services) ----
POSTGRES_IMAGE=postgres:17
RABBITMQ_IMAGE=rabbitmq:4-management
REDIS_IMAGE=redis:8
