<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="MassTransit" />
    <PackageReference Include="MassTransit.RabbitMQ" />
    <!-- Api-local Identity store (own DbContext / migrations-history table) + JWT auth.
         EntityFrameworkCore.Design is needed by `dotnet ef` to build AppIdentityDbContext at
         design time (the migration lives under Identity/Migrations in this project). -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <!-- Task 5: parses the multipart mailbox-scope CSV upload. -->
    <PackageReference Include="CsvHelper" />
    <!-- Task 10: renders the downloadable PDF migration report (Community OSS license). -->
    <PackageReference Include="QuestPDF" />
    <!-- Task 6: Redis SignalR backplane (StackExchange.Redis types flow transitively via Infrastructure). -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" />
  </ItemGroup>

  <ItemGroup>
    <!-- The API is a thin composition layer over Core abstractions + Infrastructure adapters, plus
         the three v1 connector plugins. It owns its own MassTransit bus, so it does NOT reference
         EMaigrator.Workers (which brings its own Program/host). -->
    <ProjectReference Include="..\EMaigrator.Core\EMaigrator.Core.csproj" />
    <ProjectReference Include="..\EMaigrator.Infrastructure\EMaigrator.Infrastructure.csproj" />
    <ProjectReference Include="..\EMaigrator.Connectors.Imap\EMaigrator.Connectors.Imap.csproj" />
    <ProjectReference Include="..\EMaigrator.Connectors.Graph\EMaigrator.Connectors.Graph.csproj" />
    <ProjectReference Include="..\EMaigrator.Connectors.Gmail\EMaigrator.Connectors.Gmail.csproj" />
  </ItemGroup>

</Project>
