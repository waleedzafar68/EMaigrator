<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- [SkippableFact] for the gated live supply-chain audit (xUnit 2.9.3 has no dynamic skip). -->
    <PackageReference Include="Xunit.SkippableFact" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EMaigrator.Core\EMaigrator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NetArchTest.Rules" />
    <!-- Test-only references so the architecture test can name the forbidden assemblies.
         These load into the test assembly only; EMaigrator.Core itself still references nothing. -->
    <ProjectReference Include="..\EMaigrator.Infrastructure\EMaigrator.Infrastructure.csproj" />
    <ProjectReference Include="..\EMaigrator.Connectors.Imap\EMaigrator.Connectors.Imap.csproj" />
    <ProjectReference Include="..\EMaigrator.Connectors.Graph\EMaigrator.Connectors.Graph.csproj" />
    <ProjectReference Include="..\EMaigrator.Connectors.Gmail\EMaigrator.Connectors.Gmail.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test-only references so FoundationAcceptanceTests can Assembly.Load every production
         assembly (they are copied into the test bin). EMaigrator.Core still references nothing. -->
    <ProjectReference Include="..\EMaigrator.Workers\EMaigrator.Workers.csproj" />
    <ProjectReference Include="..\EMaigrator.Api\EMaigrator.Api.csproj" />
    <ProjectReference Include="..\EMaigrator.Cli\EMaigrator.Cli.csproj" />
  </ItemGroup>

</Project>
